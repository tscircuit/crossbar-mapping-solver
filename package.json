{
  "name": "@tscircuit/crossbar-mapping-solver",
  "version": "0.0.1",
  "description": "Map columnar fanout vias into alternating crossbar bus channels",
  "module": "lib/index.ts",
  "type": "module",
  "files": [
    "lib"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/crossbar-mapping-solver.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "import": "./lib/index.ts",
      "types": "./lib/index.ts"
    }
  },
  "scripts": {
    "start": "cosmos",
    "build:site": "cosmos-export",
    "build": "bunx tsc --noEmit",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun run setup:test-deps && bun test",
    "setup:test-deps": "bun run --cwd node_modules/sharp install",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "trustedDependencies": [
    "sharp"
  ],
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@tscircuit/solver-utils": "^0.0.19",
    "graphics-debug": "^0.0.96"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "bun-match-svg": "^0.0.15",
    "react": "^19.2.8",
    "react-cosmos": "^7.3.0",
    "react-cosmos-plugin-vite": "^7.3.0",
    "react-dom": "^19.2.8",
    "sharp": "0.32.6",
    "vite": "^8.1.5"
  }
}
